CONFIG_IDF_TARGET="esp32s31"
# BENCH ADAPTER (rdpc-air 2026-11-04, reverted after the proof):
# console off UART0 (the RCP wire lives there on this bench) onto
# USB-Serial-JTAG (vanishes harmlessly if the carrier leaves it
# unconnected; nothing may share UART0 with RCP framing).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# RCP firmware: the radio task plus the UART pump share the main task
# (same 16K discipline as the standalone images).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_IPC_TASK_STACK_SIZE=4096
# C++ without RTTI, without exceptions (user directive): Rust-only tree.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASKSTACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
