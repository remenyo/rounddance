CONFIG_IDF_TARGET="esp32s31"
# NOTE: USB_SERIAL_JTAG console was tried first and the unit boot-looped
# (ROM reloads the 2nd-stage loader, SW_CPU reset, no banner); NONE keeps
# the 2nd-stage loader from touching any console peripheral at all.
# RCP firmware: the radio task plus the UART pump share the main task
# (same 16K discipline as the standalone images).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_IPC_TASK_STACK_SIZE=4096
# C++ without RTTI, without exceptions (user directive): Rust-only tree.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASKSTACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
