CONFIG_IDF_TARGET="esp32c6"
# Router hosts the join exchange + child table + route table on top of
# the adapter: 32K main-task stack like the joiner (adapter ~7.5K +
# RouterDevice + JoinerApp-class join state exceed 16K; C6 RAM allows it).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_IPC_TASK_STACK_SIZE=4096
# C++ without RTTI, without exceptions (user directive): Rust-only tree.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASKSTACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
